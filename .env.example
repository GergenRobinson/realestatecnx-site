# Copy to .env.local for local dev, and add the same keys in Vercel > Project > Settings > Environment Variables.

# Where "Get connected" and agent network requests are emailed.
CONTACT_TO_EMAIL=Gergen@GergenRobinson.com

# Free Resend account (resend.com). Without it, form entries are only written to the server log.
RESEND_API_KEY=
# Sender address. Use onboarding@resend.dev until realestatecnx.com is verified in Resend.
RESEND_FROM="Real Estate CNX <onboarding@resend.dev>"

# Optional: also POST every form entry as JSON to this URL (e.g. a Google Apps Script that appends to a Sheet).
FORM_WEBHOOK_URL=
